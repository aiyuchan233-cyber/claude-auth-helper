{
  "manifest_version": 3,
  "name": "Claude Auth Helper",
  "short_name": "ClaudeAuth",
  "version": "0.1.0",
  "description": "Local helper to store/export Claude (Anthropic) API keys for local Claudes demo.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
