# Copy to .env and fill values

PORT=3000

# OAuth provider settings (fill in from your provider)
OAUTH_AUTH_URL=https://provider.example.com/oauth2/authorize
OAUTH_TOKEN_URL=https://provider.example.com/oauth2/token
OAUTH_CLIENT_ID=your-client-id
# Redirect URI you register: http://localhost:3000/auth/callback  (or use ngrok HTTPS URL)
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_SCOPE=openid profile email

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-REPLACE_WITH_YOUR_KEY
ANTHROPIC_API_URL=https://api.anthropic.com/v1/complete

# App settings
SESSION_COOKIE_NAME=claude_auth_session
